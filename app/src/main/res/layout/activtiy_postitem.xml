<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    android:layout_gravity="center"
    android:background="@drawable/post_shape"
    android:layout_marginTop="10dp"
    android:layout_marginLeft="30dp"
    android:layout_marginRight="30dp"
    app:cardCornerRadius="10dp"
    android:layout_marginBottom="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


        <com.denzcoskun.imageslider.ImageSlider
            android:id="@+id/post_img"
            android:src="@drawable/cat"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:visibility="gone"
            tools:ignore="MissingConstraints" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/btn_setAndDelete"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="8dp"
                android:src="@drawable/cogwheel"
                android:layout_width="45dp"
                android:layout_height="45dp"
                tools:ignore="MissingConstraints" />

            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_marginLeft="5dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/post_img"
                tools:ignore="MissingConstraints">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:paddingLeft="5dp"
                    android:layout_height="wrap_content">
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/user_image"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/cat" />

                    <TextView
                        android:id="@+id/post_username"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:text="測試姓名"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:textSize="13dp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/post_id"
                        android:gravity="center"
                        android:visibility="gone"
                        android:text=""
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="20dp"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/post_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="貼文標題"
                        android:textStyle="bold"
                        android:textSize="18dp"
                        android:textColor="@color/black"/>

                    <TextView
                        android:id="@+id/post_datetime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="發佈時間：2021-05-05"
                        android:textStyle="bold"
                        android:textSize="15dp"
                        android:textColor="#0000C6"/>
                </LinearLayout>
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:padding="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/post_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="蘇軾在過去曾經講過，慎重則必成，輕發則多敗。這句話反映了問題的急切性。唬爛，發生了會如何，不發生又會如何。塞涅卡講過一句值得人反覆尋思的話，獻身於正義是簡單的，獻身於邪惡則是複雜的，而且變化無窮。我希望諸位也能好好地體會這句話。"
                android:textStyle="bold"
                android:textSize="15dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/black"/>

        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_gravity="center"
                android:gravity="center"
                android:id="@+id/insertReply"
                android:background="#F0F0F0"
                android:text="留言"
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#2828FF"
                android:layout_width="match_parent"
                android:layout_height="35dp"/>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>