<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:padding="5dp"
    android:background="@drawable/select_image_style"
    android:orientation="vertical">

    <TextView
        android:id="@+id/settingActivityName"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_margin="3dp"
        android:gravity="center"
        android:text="編輯活動名稱"

        android:textColor="#0000ff"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:ignore="MissingConstraints" />
    <View
        android:layout_width="match_parent"
        android:layout_height="3px"
        android:background="#9e9e9e" />

    <TextView
        android:id="@+id/settingActivityDate"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_margin="3dp"
        android:gravity="center"
        android:text="編輯日期/時間"
        android:textColor="#0000ff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/view_ui"
        android:layout_width="match_parent"
        android:layout_height="3px"
        android:background="#9e9e9e" />

    <View
        android:id="@+id/view_ui1"
        android:layout_width="match_parent"
        android:layout_height="3px"
        android:background="#9e9e9e" />

    <TextView
        android:id="@+id/settingActivityPeople"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_margin="3dp"
        android:gravity="center"
        android:text="編輯活動人數"
        android:textColor="#0000ff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/view_ui2"
        android:layout_width="match_parent"
        android:layout_height="3px"
        android:background="#9e9e9e" />

    <TextView
        android:id="@+id/settingActivityContext"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_margin="3dp"
        android:gravity="center"
        android:text="編輯活動內容"
        android:textColor="#0000ff"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>