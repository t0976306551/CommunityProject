<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reply_cardview"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/replyitem_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="MissingConstraints">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/otherImage"
                        android:src="@drawable/user_preset"
                        android:layout_width="40dp"
                        android:layout_height="40dp"/>

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/cancel"
                        android:src="@drawable/cancel"
                        app:layout_constraintRight_toRightOf="parent"

                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                    

                    <LinearLayout
                        android:id="@+id/user"
                        android:layout_marginLeft="5dp"
                        app:layout_constraintTop_toTopOf="@id/otherImage"
                        app:layout_constraintStart_toEndOf="@id/otherImage"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/uesrname"
                        android:layout_marginLeft="5sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="USERNAME"
                        android:padding="3dp"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:ellipsize="none"
                        android:maxLines="100"
                        android:scrollHorizontally="false"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:id="@+id/inserdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="10dp"
                        android:text="2021-05-31 21:09:54"
                        android:textColor="#2828FF"
                        android:textStyle="bold"
                        android:ellipsize="none"
                        android:maxLines="100"

                        android:scrollHorizontally="false"
                        tools:ignore="MissingConstraints" />
                    </LinearLayout>

                    <TextView

                        app:layout_constraintStart_toEndOf="@id/user"
                        app:layout_constraintTop_toTopOf="@id/user"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/replycontext"
                        android:layout_marginLeft="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="我們都很清楚，這是個嚴謹的議題。我以為我了解報告，但我真的了解報告嗎？仔細想想，我對報告的理解只是皮毛而已。"
                        android:padding="10dp"
                        android:ellipsize="none"
                        android:maxLines="100"
                        android:scrollHorizontally="false"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/user"
                        app:layout_constraintStart_toStartOf="@id/otherImage"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:id="@+id/replyMessage"
                        android:textColor="#0000C6"
                        android:textStyle="bold"
                        android:text="回覆"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/replycontext"
                        android:padding="3dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>