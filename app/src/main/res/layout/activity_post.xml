<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Post.PostActivity">

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="#005AB5"
      tools:ignore="MissingConstraints">

    <TextView
        android:id="@+id/headerText"
        android:padding="15dp"
        android:textSize="25dp"
        android:text="社區貼文"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/insert_post"
        android:text="新增貼文"
        android:textStyle="bold"
        android:visibility="visible"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="@id/headerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/headerText"
        android:layout_marginRight="10dp"
        android:background="@drawable/btn_insert_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/linearSearch"
        android:gravity="center"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/headerText"
        app:layout_constraintStart_toStartOf="@+id/headerText"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
          android:id="@+id/search"
          android:hint="輸入貼文標題以查詢"
            android:paddingLeft="15dp"
            android:layout_marginLeft="10dp"
          android:background="@drawable/edtext_style"
          android:textColorHint="@color/black"
          android:textStyle="bold"
          android:layout_weight="1.0"
          android:layout_marginRight="10dp"
          android:layout_width="wrap_content"
          android:layout_height="35dp"/>

      <Button
          android:id="@+id/btn_search"
          android:text="查詢"
          android:textStyle="bold"
          android:layout_gravity="end"
         android:layout_marginRight="10dp"
          android:background="@drawable/btn_insert_style"
          android:textColor="@color/white"
          android:layout_width="wrap_content"
          android:layout_height="30dp"/>


    </LinearLayout>
    <LinearLayout
        app:layout_constraintTop_toBottomOf="@id/linearSearch"
        android:layout_width="match_parent"
        android:layout_height="10dp"/>

  </androidx.constraintlayout.widget.ConstraintLayout>


  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:orientation="vertical"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/header"
      app:layout_constraintBottom_toBottomOf="parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/gank_swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
          <androidx.recyclerview.widget.RecyclerView
              android:layout_marginTop="2dp"
              android:id="@+id/postRecyclerView"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              tools:ignore="MissingConstraints" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>